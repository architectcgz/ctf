{
  "layers": {
    "common": {
      "relative_prefixes": [
        "shared/ui/common/",
        "shared/model/common/",
        "shared/lib/"
      ],
      "forbidden_import_layers": ["pages", "features", "widgets"]
    },
    "shared": {
      "relative_prefixes": ["shared/"],
      "forbidden_import_layers": ["features", "widgets", "pages"]
    },
    "entities": {
      "relative_prefixes": ["entities/"],
      "forbidden_import_layers": ["pages", "features", "widgets"]
    },
    "pages": {
      "relative_prefixes": ["pages/"],
      "forbidden_import_layers": []
    },
    "features": {
      "relative_prefixes": ["features/"],
      "forbidden_import_layers": ["pages", "widgets"]
    },
    "widgets": {
      "relative_prefixes": ["widgets/"],
      "forbidden_import_layers": ["pages"]
    }
  },
  "route_page_layer": "pages",
  "route_page_suffix": "RoutePage.vue",
  "route_page_line_limit": 500,
  "legacy_business_component_directories": [],
  "component_api_contract_only": true,
  "widget_api_contract_only": true,
  "feature_ui_api_contract_only": true,
  "low_level_forbidden_import_prefixes": [
    "@/api",
    "@/features",
    "@/widgets",
    "@/views",
    "@/stores",
    "@/router"
  ],
  "low_level_forbidden_bare_imports": ["vue-router", "pinia"],
  "store_forbidden_import_prefixes": ["@/views", "@/components"],
  "utility_forbidden_import_prefixes": [
    "@/api",
    "@/features",
    "@/widgets",
    "@/views",
    "@/stores",
    "@/router",
    "@/components"
  ],
  "utility_forbidden_bare_imports": ["vue", "vue-router", "pinia"],
  "feature_router_forbidden_imports": ["vue-router", "@/router"],
  "route_page": {
    "allow_api_contract_imports_only": true,
    "forbidden_runtime_hooks": [
      "useRoute",
      "useRouter",
      "router.push",
      "router.replace",
      "useRouteQueryTabs"
    ]
  },
  "growth_baseline_file": "scripts/frontend-growth-baseline.json",
  "feature_boundary_guard_tests": [
    "src/features/contest-awd-admin/model/useAwdOwnerBoundaries.test.ts",
    "src/features/contest-awd-admin/model/usePlatformContestAwdBoundary.test.ts",
    "src/features/contest-awd-admin/ui/useAwdOperationsPanelViewState.test.ts",
    "src/features/layout/model/useLayoutBridgeBoundaries.test.ts",
    "src/features/layout/model/useLayoutPublicApiBoundary.test.ts",
    "src/features/auth/model/useAuthPublicApiBoundary.test.ts",
    "src/features/notifications/model/useNotificationDrawerPublicApiBoundary.test.ts",
    "src/entities/notification/model/notificationTypeMetaOwnershipBoundary.test.ts",
    "src/entities/instance/model/presentationBoundary.test.ts",
    "src/features/platform/challenge-topology-studio/model/topologyStudioBoundary.test.ts",
    "src/features/awd-inspector/model/awdInspectorBoundary.test.ts",
    "src/features/platform/contest-projector/model/contestProjectorBoundary.test.ts",
    "src/features/platform/contest-awd-config/model/contestAwdConfigBoundary.test.ts",
    "src/features/contest-workbench/model/contestWorkbenchBoundary.test.ts"
  ]
}
