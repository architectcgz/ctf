# Copy to /etc/ctf/runtime-agent/runtime-agent.env and adjust per runtime node.
#
# APP_ENV is set by ctf-runtime-agent.service. ctf-runtime-agent uses the
# runtime-agent config loader, so API-only PostgreSQL, Redis, CORS, and flag
# secret settings are not required on the Docker host.

CTF_RUNTIME_AGENT_SERVER_ENABLED=true
CTF_RUNTIME_AGENT_SERVER_NODE_NAME=runtime-node-a
CTF_RUNTIME_AGENT_SERVER_HOST=0.0.0.0
CTF_RUNTIME_AGENT_SERVER_PORT=9443
CTF_RUNTIME_AGENT_SERVER_CERT_FILE=/etc/ctf/runtime-agent/server.pem
CTF_RUNTIME_AGENT_SERVER_KEY_FILE=/etc/ctf/runtime-agent/server-key.pem
CTF_RUNTIME_AGENT_SERVER_CLIENT_CA_FILE=/etc/ctf/runtime-agent/ca.pem
CTF_RUNTIME_AGENT_SERVER_KEEPALIVE_MIN_TIME=30s
CTF_RUNTIME_AGENT_SERVER_SHUTDOWN_TIMEOUT=10s

# Omit DOCKER_HOST to use the local Unix socket at /var/run/docker.sock.
# Use a TLS-protected Docker endpoint only when the runtime node explicitly
# manages Docker through a remote daemon.
# DOCKER_HOST=unix:///var/run/docker.sock

# Keep this root on persistent storage if runtime features need local files.
CTF_SHARED_STORAGE_SHARED_FS_ROOT=/var/lib/ctf

# Checker sandbox defaults mirror configs/config.yaml. Override them here only
# when the runtime node uses different capacity or sandbox image policy.
CTF_CONTEST_AWD_CHECKER_SANDBOX_IMAGE=python:3.12-alpine
CTF_CONTEST_AWD_CHECKER_SANDBOX_USER=65532:65532
CTF_CONTEST_AWD_CHECKER_SANDBOX_WORK_DIR=/checker
CTF_CONTEST_AWD_CHECKER_SANDBOX_TIMEOUT=10s
CTF_CONTEST_AWD_CHECKER_SANDBOX_CPU_QUOTA=0.5
CTF_CONTEST_AWD_CHECKER_SANDBOX_MEMORY_BYTES=134217728
CTF_CONTEST_AWD_CHECKER_SANDBOX_PIDS_LIMIT=64
CTF_CONTEST_AWD_CHECKER_SANDBOX_NOFILE_LIMIT=128
CTF_CONTEST_AWD_CHECKER_SANDBOX_OUTPUT_LIMIT_BYTES=32768
